// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  APPLIED_PENDING_TEST
  SCREENING
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id      String               @id @default(uuid())
  email   String               @unique
  profile ProfessionalProfile?
  name    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications JobApplication[]
}

model Company {
  id       String  @id @default(uuid())
  name     String
  website  String?
  industry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications JobApplication[]
}

enum JobCategory {
  IT
  NON_IT
  UNCATEGORIZED
}

model JobApplication {
  id String @id @default(uuid())

  userId    String
  companyId String

  platform       String?
  jobDescription String?
  analyses       ApplicationAnalysis[]
  resumes        ResumeVersion[]
  position       String
  jobUrl         String?
  location       String?

  status ApplicationStatus @default(WISHLIST)
  category JobCategory @default(UNCATEGORIZED)

  salaryMin Int?
  salaryMax Int?
  currency  String?

  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model ProfessionalProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApplicationAnalysis {
  id              String          @id @default(uuid())
  applicationId   String
  content         Json
  profileSnapshot Json
  jobDescription  String
  model           String
  promptVersion   String
  createdAt       DateTime        @default(now())
  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumes         ResumeVersion[]

  @@index([applicationId, createdAt])
}

model ResumeVersion {
  id              String              @id @default(uuid())
  applicationId   String
  analysisId      String
  content         Json
  profileSnapshot Json
  jobDescription  String
  model           String
  promptVersion   String
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  application     JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  analysis        ApplicationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([analysisId])
}
